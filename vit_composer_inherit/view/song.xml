        <!-- form view -->
        <record id="view_song_form" model="ir.ui.view">
            <field name="name">song_form</field>
            <field name="model">vit.song</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="vit_composer.view_vit_song_form"/>
            <field name="arch" type="xml">
                <field name="lyrics" position="replace"/>
                <field name="original_url" position="replace"/>
                <field name="song_mp3" position="replace"/>
                <field name="song_mp3_url" position="replace"/>
                <field name="song_mp3_filename" position="replace"/>
                <xpath expr="//notebook/page[@name='scene_ids']" position="before">
                    <page string="Song Details">
                        <group>
                            <group>
                                <field name="lyrics"/>
                            </group>
                            <group>
                                <field name="original_url" />
                                <field name="song_mp3_url" widget="audio_player"/>
                                <field name="song_mp3" filename="song_mp3_filename"/>
                                <field name="song_mp3_filename" invisible="True"/>
                            </group>
                        </group>
                    </page>
                    <!-- <page string="Actors">
                        <group>
                            <group>
                                <field name="actor1_image_prompt"/>
                                <field name="actor1_image_url"/>
                                <field name="actor1_image" widget="image" options="{'width':500}"/>
                                <button name="generate_actor1" type="object" string="Generate Actor 1"/>
                            </group>    
                            <group>
                                <field name="actor2_image_prompt" />
                                <field name="actor2_image_url" />
