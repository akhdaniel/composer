        <!-- form view -->
        <record id="view_scene_form" model="ir.ui.view">
            <field name="name">scene_form</field>
            <field name="model">vit.scene</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="vit_composer.view_vit_scene_form"/>
            <field name="arch" type="xml">
                <field name="video_prompt" position="replace"/>
                <field name="image_prompt" position="replace"/>
                <field name="video_url" position="replace"/>
                <field name="video_mp4" position="replace"/>
                <field name="image_url" position="replace"/>
                <field name="image_png" position="replace"/>
                <field name="lip_sync" position="replace"/>

                <field name="clip_mp3" position="replace"/>
                <field name="clip_mp3_filename" position="replace"/>
                <field name="clip_mp3_url" position="replace"/>

                <notebook position="inside">
                    <page string="Images">
                        <group>
                            <field name="image_prompt"/>
                            <field name="image_url"/><button name="download_image" type="object" string="Download Image"/>
                            <field name="image_png" widget="image"/>
                        </group>
                    </page>
                    <page string="Video Clips">
                        <group>
                            <group string="Video">
                                <field name="lip_sync" help="Lip sync with audio clips?"/>
                                <field name="video_prompt"/>
                                <field name="video_url" /><button name="download_video" type="object" string="Download Video"/>
                                <field name="video_mp4" widget="video_player"/>
                            </group>
                            <group string="Audio">
                                <field name="clip_mp3"/>
                                <field name="clip_mp3_filename" invisible="True"/>
                                <field name="clip_mp3_url" widget="audio_player"/>
                            </group>
                        </group>
                    </page>
                    
                </notebook>
            </field>
        </record>
