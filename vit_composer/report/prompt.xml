<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- report qweb view -->
        <record id="action_report_vit_prompt" model="ir.actions.report">
            <field name="name">Prompt</field>
            <field name="model">vit.prompt</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">vit_composer.vit_prompt_report</field>
            <field name="report_file">vit_composer.vit_prompt_report</field>
            <field name="print_report_name">object.name</field>
            <field name="binding_model_id" ref="vit_composer.model_vit_prompt"/>
            <field name="binding_type">report</field>
        </record>
        <!-- document template -->
        <template id="vit_composer.vit_prompt_report_document" >
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context({'lang': lang})"/>
                <div class="page">
                    <h2>
                        Prompt: <span t-field="doc.name"/>
                    </h2>
                    <div class="row mt32 mb32">
                        <div class="col-auto mw-100 mb-2">
                            <strong>User Prompt</strong>
                            <p class="m-0" t-field="doc.user_prompt" />
                        </div>
                        <div class="col-auto mw-100 mb-2">
                            <strong>System Prompt</strong>
                            <p class="m-0" t-field="doc.system_prompt" />
                        </div>
                    </div>
                </div>
                <div class="oe_structure"/>
            </t>
        </template>

        <!-- main template -->
        <template id="vit_composer.vit_prompt_report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="lang" t-value="doc.create_uid.lang"/>
                    <t t-call="vit_composer.vit_prompt_report_document" />
                </t>
            </t>
        </template>

    </data>
</odoo>